<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/recipeToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_brown"
        app:navigationIconTint="@color/on_primary"
        app:titleTextColor="@color/on_primary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/recipeDetails"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:paddingBottom="@dimen/space_32">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.CookPin.Card"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    app:cardCornerRadius="@dimen/radius_large"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/recipePhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/recipe_photo"
                        android:scaleType="centerCrop" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/recipeTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_20"
                    android:accessibilityHeading="true"
                    android:textColor="@color/on_surface"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/recipeTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_meta_chip"
                    android:textAppearance="@style/TextAppearance.CookPin.Meta" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startCooking"
                    style="@style/Widget.CookPin.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_20"
                    android:text="@string/start_cooking" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shoppingRecipe"
                    style="@style/Widget.CookPin.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/add_to_shopping" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pinRecipe"
                    style="@style/Widget.CookPin.Button.Pin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/pin_recipe" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.CookPin.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    app:contentPadding="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/adjust_servings"
                            android:textAppearance="@style/TextAppearance.CookPin.Section" />

                        <LinearLayout
                            android:id="@+id/portionControls"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/decreasePortions"
                                style="@style/Widget.CookPin.Button.Tonal"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:contentDescription="@string/decrease_portions"
                                android:text="−"
                                android:textSize="22sp" />

                            <TextView
                                android:id="@+id/portionSummary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:paddingStart="@dimen/space_8"
                                android:paddingEnd="@dimen/space_8"
                                android:textColor="@color/on_surface"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/increasePortions"
                                style="@style/Widget.CookPin.Button.Tonal"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:contentDescription="@string/increase_portions"
                                android:text="+"
                                android:textSize="22sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/portionNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_info_callout"
                    android:text="@string/portion_note"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/recipeIngredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:accessibilityHeading="true"
                    android:text="@string/ingredients"
                    android:textAppearance="@style/TextAppearance.CookPin.Section" />

                <TextView
                    android:id="@+id/recipeIngredientsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:lineSpacingExtra="5dp"
                    android:textAppearance="@style/TextAppearance.CookPin.Body" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_24"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/recipeInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:accessibilityHeading="true"
                    android:text="@string/instructions"
                    android:textAppearance="@style/TextAppearance.CookPin.Section" />

                <TextView
                    android:id="@+id/recipeInstructionsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:lineSpacingExtra="7dp"
                    android:textAppearance="@style/TextAppearance.CookPin.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/recipeSource"
                    style="@style/Widget.CookPin.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/view_recipe_source"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/cookingMode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_background"
            android:orientation="vertical"
            android:padding="@dimen/space_20"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/closeCooking"
                style="@style/Widget.CookPin.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/close_cooking" />

            <TextView
                android:id="@+id/cookingRecipeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.CookPin.ScreenIntro" />

            <TextView
                android:id="@+id/cookingStepCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:accessibilityHeading="true"
                android:textColor="@color/brand_primary_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/cookingProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                app:indicatorColor="@color/brand_green"
                app:trackColor="@color/brand_green_light" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CookPin.Card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/space_20"
                android:layout_weight="1"
                app:contentPadding="@dimen/space_20">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <TextView
                        android:id="@+id/cookingStepText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="8dp"
                        android:textColor="@color/on_surface"
                        android:textSize="22sp" />
                </ScrollView>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/previousCookingStep"
                    style="@style/Widget.CookPin.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="@string/previous_step" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nextCookingStep"
                    style="@style/Widget.CookPin.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:text="@string/next_step" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
