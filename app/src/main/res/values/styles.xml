<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.CookPin.ScreenIntro" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CookPin.Section" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CookPin.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.CookPin.Meta" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.CookPin.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_medium</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.CookPin.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/brand_brown</item>
        <item name="cornerRadius">@dimen/radius_small</item>
        <item name="insetTop">0dp</item>
        <item name="insetBottom">0dp</item>
    </style>

    <style name="Widget.CookPin.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_brown</item>
        <item name="strokeColor">@color/outline</item>
        <item name="cornerRadius">@dimen/radius_small</item>
        <item name="insetTop">0dp</item>
        <item name="insetBottom">0dp</item>
    </style>

    <style name="Widget.CookPin.Button.Tonal" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brand_brown_dark</item>
        <item name="backgroundTint">@color/surface_variant</item>
        <item name="cornerRadius">@dimen/radius_small</item>
        <item name="insetTop">0dp</item>
        <item name="insetBottom">0dp</item>
    </style>

    <style name="Widget.CookPin.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brand_brown</item>
    </style>
</resources>
